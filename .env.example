# ==============================================================
# Student Learning Monitoring System - Environment Configuration
# ==============================================================

# --- Port Settings ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
PROXY_PORT=80

# --- Security ---
SECRET_KEY=super-secret-learning-monitoring-key-2026

# --- Database Selection ---
# Option 1: SQLite (Default, Zero-Configuration, Volume-Persisted)
DATABASE_URL=sqlite:///./data/learning_monitor.db

# Option 2: PostgreSQL (Used when running with --profile postgres)
# DATABASE_URL=postgresql://monitor_user:monitor_secret_2026@db:5432/learning_monitor

# --- PostgreSQL Container Credentials (Only if using db container) ---
POSTGRES_DB=learning_monitor
POSTGRES_USER=monitor_user
POSTGRES_PASSWORD=monitor_secret_2026

# --- Client-Facing Endpoint URLs ---
# For Localhost Docker setup:
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/session

# For Production Domain with Nginx Reverse Proxy (e.g. monitor.myschool.edu):
# NEXT_PUBLIC_API_URL=https://monitor.myschool.edu/api
# NEXT_PUBLIC_WS_URL=wss://monitor.myschool.edu/ws/session

